# StreetPi away gateway for stock caddy:2. No plugins.
# Listens on the Pi at http://127.0.0.1:8447 only.
# Anything that is not a named allowlist matcher returns 404.
# A missing Cf-Access-Jwt-Assertion header returns 403.
# Rate limiting is a Cloudflare edge rule. Do not add it here.
{
	admin off
	auto_https off
}

(pihole) {
	reverse_proxy https://127.0.0.1:443 {
		header_up -CF-Access-Client-Id
		header_up -CF-Access-Client-Secret
		header_up -Cf-Access-Jwt-Assertion
		header_up -Cookie
		transport http {
			tls_server_name pi.hole
			tls_trust_pool file /etc/caddy/pihole-ca.pem
			response_header_timeout 30s
		}
	}
}

(pihole_stream) {
	reverse_proxy https://127.0.0.1:443 {
		header_up -CF-Access-Client-Id
		header_up -CF-Access-Client-Secret
		header_up -Cf-Access-Jwt-Assertion
		header_up -Cookie
		flush_interval -1
		transport http {
			tls_server_name pi.hole
			tls_trust_pool file /etc/caddy/pihole-ca.pem
			response_header_timeout 30s
		}
	}
}

(pihole_gravity) {
	reverse_proxy https://127.0.0.1:443 {
		header_up -CF-Access-Client-Id
		header_up -CF-Access-Client-Secret
		header_up -Cf-Access-Jwt-Assertion
		header_up -Cookie
		transport http {
			tls_server_name pi.hole
			tls_trust_pool file /etc/caddy/pihole-ca.pem
			response_header_timeout 310s
		}
	}
}

(netdata) {
	route {
		uri strip_prefix /netdata
		reverse_proxy 127.0.0.1:19999 {
			header_up -CF-Access-Client-Id
			header_up -CF-Access-Client-Secret
			header_up -Cf-Access-Jwt-Assertion
			header_up -Cookie
			transport http {
				response_header_timeout 30s
			}
		}
	}
}

(kuma) {
	route {
		uri strip_prefix /kuma
		reverse_proxy 127.0.0.1:3001 {
			header_up -CF-Access-Client-Id
			header_up -CF-Access-Client-Secret
			header_up -Cf-Access-Jwt-Assertion
			header_up -Cookie
			transport http {
				response_header_timeout 30s
			}
		}
	}
}

http://127.0.0.1:8447 {
	bind 127.0.0.1
	log {
		output stdout
		format filter {
			wrap json
			fields {
				# Keep the path and drop the query string. A backslash
				# before "?" does not survive adapt, so the class is the mark.
				request>uri regexp "[?].*$" ""
				request>headers delete
				resp_headers delete
			}
		}
	}

	request_body {
		max_size 4KB
	}

	header {
		X-Content-Type-Options nosniff
		Cache-Control no-store
		defer
	}

	@nojwt not header Cf-Access-Jwt-Assertion *
	handle @nojwt {
		respond "Forbidden" 403
	}

	@allow_get_api_info_login {
		method GET
		path /api/info/login
	}
	handle @allow_get_api_info_login {
		import pihole
	}
	@allow_get_api_stats_summary {
		method GET
		path /api/stats/summary
	}
	handle @allow_get_api_stats_summary {
		import pihole
	}
	@allow_get_api_history {
