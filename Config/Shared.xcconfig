// Shared build settings. Override STREETPI_BUNDLE_IDENTIFIER to change the sideload id.
// STREETPI_APP_GROUP_IDENTIFIER is reserved for a later extension. It is not an entitlement yet.

SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
IPHONEOS_DEPLOYMENT_TARGET = 18.0
TARGETED_DEVICE_FAMILY = 1,2
SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SUPPORTS_MACCATALYST = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO
CODE_SIGN_STYLE = Manual
CODE_SIGNING_REQUIRED = NO
CODE_SIGNING_ALLOWED = NO
DEVELOPMENT_TEAM =
STREETPI_BUNDLE_IDENTIFIER = com.streetfam.streetpi
STREETPI_APP_GROUP_IDENTIFIER = group.com.streetfam.streetpi
MARKETING_VERSION = 1.1.0
CURRENT_PROJECT_VERSION = 3
ENABLE_USER_SCRIPT_SANDBOXING = YES
